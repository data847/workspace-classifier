# ============================================================
# Copy this file to .env and fill in the values
#   cp .env.example .env
# ============================================================

# ── LLM (classify mode only — not needed for --export-only) ─
# Anthropic (Claude) — recommended
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OR OpenAI (GPT)
# OPENAI_API_KEY=sk-proj-...
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# ── Google Service Account (required) ───────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── AWS S3 (optional — for --s3-bucket) ─────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1

# ── Hetzner Storage Box (optional — for --hetzner) ──────────
# Creds are prompted in the terminal when you run with --hetzner.
# Set these env vars only if you want to skip the prompt:
#
# SFTP_HOST=u123456.your-storagebox.de
# SFTP_PORT=23
# SFTP_USERNAME=u123456
# SFTP_PASSWORD=
# SFTP_BASE_PATH=workspace

# ── Tuning (optional) ────────────────────────────────────────
# PIPELINE_1TB_PASS1_MODEL=gpt-4o-mini
# PIPELINE_1TB_PASS1_BATCH=100
# PIPELINE_1TB_PASS2_BATCH=25
