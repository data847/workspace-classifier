# ============================================================
# Copy this file to .env and fill in the values
#   cp .env.example .env
# ============================================================

# ── LLM (required) ──────────────────────────────────────────
# Anthropic (Claude) — recommended
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OR OpenAI (GPT)
# OPENAI_API_KEY=sk-proj-...
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# ── Google Service Account (required) ───────────────────────
# Path to service_account.json with Domain-Wide Delegation enabled.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── AWS S3 (optional — only needed for --s3-bucket) ─────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1

# ── Tuning (optional) ────────────────────────────────────────
# Fast model for pass-1 (all files); defaults to gpt-4o-mini / claude-haiku
# PIPELINE_1TB_PASS1_MODEL=gpt-4o-mini
# PIPELINE_1TB_PASS1_BATCH=100
# PIPELINE_1TB_PASS2_BATCH=25
